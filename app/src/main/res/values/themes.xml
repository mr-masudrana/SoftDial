<resources>
    <!-- Light bar, same color as the bottom navigation (bar_bg). -->
    <style name="Theme.SoftDial" parent="Theme.AppCompat.DayNight">
        <item name="colorPrimary">@color/bar_bg</item>
        <item name="colorPrimaryDark">@color/bar_bg</item>
        <item name="colorAccent">@color/nav_active</item>
        <item name="android:statusBarColor">@color/bar_bg</item>
        <item name="android:navigationBarColor">@color/bar_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Splash screen (icon on the app color) shown while the app starts -->
    <style name="Theme.SoftDial.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SoftDial</item>
    </style>
</resources>
