<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp">

            <RadioGroup
                android:id="@+id/rgFwd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/rbFwdOff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_fwd_off" />
                <RadioButton
                    android:id="@+id/rbFwdAlways"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_fwd_always" />
                <RadioButton
                    android:id="@+id/rbFwdBusy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_fwd_busy" />
                <RadioButton
                    android:id="@+id/rbFwdNoAnswer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_fwd_noanswer" />
            </RadioGroup>
            <EditText
                android:id="@+id/etFwdNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/set_fwd_number"
                android:inputType="phone" />
            <EditText
                android:id="@+id/etFwdDelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/set_fwd_delay"
                android:inputType="number" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/set_fwd_note"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btnFwdSave"
                style="@style/Widget.AppCompat.Button.Borderless.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_fwd_save"
                android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
